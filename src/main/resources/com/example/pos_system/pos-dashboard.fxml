<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pos_system.controller.PosDashboardController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="800.0" style="-fx-background-color: #333333;" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
            <children>
                <Label text="Point of Sale System" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblUsername" text="Welcome, User" textFill="WHITE">
                    <font>
                        <Font size="14.0" />
                    </font>
                    <HBox.margin>
                        <Insets right="20.0" />
                    </HBox.margin>
                </Label>
                <Button mnemonicParsing="false" onAction="#handleLogout" text="Logout" />
            </children>
        </HBox>
    </top>
    <center>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="10.0" top="20.0" />
            </padding>
            <children>
                <Label text="Products">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <TableView fx:id="productsTable" prefHeight="450.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colProductName" prefWidth="250.0" text="Product Name" />
                        <TableColumn fx:id="colProductPrice" prefWidth="100.0" text="Price" />
                        <TableColumn fx:id="colProductStock" prefWidth="100.0" text="Stock" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleAddToCart" text="Add to Cart" />
                        <Label text="Quantity:" />
                        <Spinner fx:id="spinnerQuantity" prefWidth="80.0" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
    <right>
        <VBox prefHeight="200.0" prefWidth="300.0" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="10.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label text="Current Order">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <TableView fx:id="cartTable" prefHeight="350.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCartName" prefWidth="120.0" text="Item" />
                        <TableColumn fx:id="colCartQty" prefWidth="50.0" text="Qty" />
                        <TableColumn fx:id="colCartSubtotal" prefWidth="80.0" text="Subtotal" />
                    </columns>
                </TableView>
                <Button mnemonicParsing="false" onAction="#handleRemoveFromCart" text="Remove Selected" />
                <Region VBox.vgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Label text="Total:">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblTotal" text="\$0.00">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCheckout" prefHeight="40.0" style="-fx-background-color: #4CAF50;" text="Checkout" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
            </children>
        </VBox>
    </right>
</BorderPane>
